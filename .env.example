# Copy this file to .env.local and fill in the values.
# For local development, run `npx supabase status` and copy the values from there.

# Supabase project URL ("Project URL" in the Supabase dashboard, or API_URL locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key, safe to expose in the browser ("Publishable key", or PUBLISHABLE_KEY locally)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, server only. Never expose it in the browser. ("Secret key", or SECRET_KEY locally)
# Used by `npm run db:seed` to create demo accounts.
SUPABASE_SECRET_KEY=
